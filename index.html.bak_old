<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Creatify Workspace</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: rgba(30, 41, 59, 0.7);
            --card-border: rgba(255, 255, 255, 0.1);
            --primary: #38bdf8;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent: #818cf8;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }

        body {
            background-color: var(--bg-color);
            background-image: 
                radial-gradient(at 0% 0%, rgba(56, 189, 248, 0.12) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(129, 140, 248, 0.12) 0px, transparent 50%);
            background-attachment: fixed;
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            padding: 40px 20px 20px;
        }

        .container { max-width: 1100px; width: 100%; }

        header { text-align: center; margin-bottom: 40px; }

        .badge {
            display: inline-block;
            padding: 6px 14px;
            background: rgba(56, 189, 248, 0.1);
            border: 1px solid rgba(56, 189, 248, 0.2);
            color: var(--primary);
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        header h1 {
            font-size: 2.2rem;
            font-weight: 700;
            margin-bottom: 10px;
            background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        header p { color: var(--text-muted); font-size: 1rem; }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 16px;
        }

        .app-card {
            background: var(--card-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--card-border);
            border-radius: 14px;
            padding: 20px;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.2s ease;
        }

        .app-card:hover {
            transform: translateY(-3px);
            border-color: rgba(56, 189, 248, 0.4);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .icon-box {
            width: 40px;
            height: 40px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .arrow { color: var(--text-muted); transition: transform 0.2s, color 0.2s; }
        .app-card:hover .arrow { transform: translateX(4px); color: var(--primary); }

        .app-title { font-size: 1.05rem; font-weight: 600; margin-bottom: 4px; color: #fff; }
        .app-desc { font-size: 0.825rem; color: var(--text-muted); line-height: 1.4; }

        footer {
            margin-top: 50px;
            text-align: center;
            font-size: 0.85rem;
            color: var(--text-muted);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding-top: 20px;
            width: 100%;
        }
    </style>
</head>
<body>

    <div class="container">
        <header>
            <span class="badge">Eksosistem Web Termux</span>
            <h1>Creatify Workspace</h1>
            <p>Daftar seluruh aplikasi web yang aktif dan siap diakses.</p>
        </header>

        <div class="grid">
            <!-- Absensi -->
            <a href="/absen/" class="app-card">
                <div class="card-header"><div class="icon-box">📋</div><span class="arrow">➔</span></div>
                <div class="app-title">Absen Siswa QR</div>
                <div class="app-desc">Sistem absensi berbasis QR Code.</div>
            </a>

            <a href="/absen-tahfidh/" class="app-card">
                <div class="card-header"><div class="icon-box">🕌</div><span class="arrow">➔</span></div>
                <div class="app-title">Absen Tahfidh Lite</div>
                <div class="app-desc">Presensi santri tahfidh versi lite.</div>
            </a>

            <a href="/tahfidh-absensi/" class="app-card">
                <div class="card-header"><div class="icon-box">📖</div><span class="arrow">➔</span></div>
                <div class="app-title">Tahfidh Absensi Pro</div>
                <div class="app-desc">Manajemen & rekap absensi tahfidh.</div>
            </a>

            <!-- Bisnis & Produktivitas -->
            <a href="/kasir/" class="app-card">
                <div class="card-header"><div class="icon-box">🛒</div><span class="arrow">➔</span></div>
                <div class="app-title">POS Kasir</div>
                <div class="app-desc">Aplikasi kasir & pencatatan transaksi.</div>
            </a>

            <a href="/cbt/" class="app-card">
                <div class="card-header"><div class="icon-box">📝</div><span class="arrow">➔</span></div>
                <div class="app-title">CBT Firebase</div>
                <div class="app-desc">Ujian online berbasis cloud Firebase.</div>
            </a>

            <a href="/voting/" class="app-card">
                <div class="card-header"><div class="icon-box">🗳️</div><span class="arrow">➔</span></div>
                <div class="app-title">Voting Massal</div>
                <div class="app-desc">Sistem pemungutan suara online.</div>
            </a>

            <a href="/notepad/" class="app-card">
                <div class="card-header"><div class="icon-box">📝</div><span class="arrow">➔</span></div>
                <div class="app-title">Online Notepad</div>
                <div class="app-desc">Catatan online cepat & ringan.</div>
            </a>

            <a href="/chat/" class="app-card">
                <div class="card-header"><div class="icon-box">💬</div><span class="arrow">➔</span></div>
                <div class="app-title">Aplikasi Chat</div>
                <div class="app-desc">Platform komunikasi messaging.</div>
            </a>

            <!-- Media & Islami -->
            <a href="/yasin/" class="app-card">
                <div class="card-header"><div class="icon-box">📗</div><span class="arrow">➔</span></div>
                <div class="app-title">Yasin & Tahlil</div>
                <div class="app-desc">Bacaan Yasin & Tahlil standar.</div>
            </a>

            <a href="/tahlil-vue/" class="app-card">
                <div class="card-header"><div class="icon-box">⚡</div><span class="arrow">➔</span></div>
                <div class="app-title">Yasin Vue App</div>
                <div class="app-desc">Aplikasi Yasin berbasis Vue.js.</div>
            </a>

            <a href="/acaraplay/" class="app-card">
                <div class="card-header"><div class="icon-box">▶️</div><span class="arrow">➔</span></div>
                <div class="app-title">AcaraPlay Vanilla</div>
                <div class="app-desc">Media player interaktif acara.</div>
            </a>

            <a href="/music-player/" class="app-card">
                <div class="card-header"><div class="icon-box">🎵</div><span class="arrow">➔</span></div>
                <div class="app-title">Music Player Acara</div>
                <div class="app-desc">Pemutar musik web khusus event.</div>
            </a>

            <a href="/iklan-tv/" class="app-card">
                <div class="card-header"><div class="icon-box">📺</div><span class="arrow">➔</span></div>
                <div class="app-title">Display Iklan TV</div>
                <div class="app-desc">Sistem display informasi & iklan.</div>
            </a>

            <a href="/twibbon/" class="app-card">
                <div class="card-header"><div class="icon-box">🖼️</div><span class="arrow">➔</span></div>
                <div class="app-title">Twibbon Maker</div>
                <div class="app-desc">Generator bingkai foto twibbon.</div>
            </a>

            

            <a href="/capacitor-builder/" class="app-card">
                <div class="card-header"><div class="icon-box">⚙️</div><span class="arrow">➔</span></div>
                <div class="app-title">Auto Build APK</div>
                <div class="app-desc">Web builder APK via Capacitor.</div>
            </a>
        </div>
    </div>

    <footer>
        &copy; 2026 Creatify Workspace. All rights reserved.
    </footer>

</body>
</html>
